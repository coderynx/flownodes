<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.TestingHost" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\packages\engine\Engine.Infrastructure\Engine.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\integrations\flownodes.simulator\Flownodes.Simulator.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>


    <!-- The loader tests read the simulator's staged publish output; the reference restores it but never builds it. -->
    <Target Name="StageSimulator" BeforeTargets="BeforeBuild">
        <MSBuild Projects="..\..\..\integrations\flownodes.simulator\Flownodes.Simulator.csproj" Targets="Build" />
    </Target>

</Project>
