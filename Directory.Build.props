<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- ADR-0021: exposed contracts documented; tests are out of scope. ADR-0024: IDE0005 only reports in a build
         when the documentation file is generated, so tests generate it too. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    </ItemGroup>

    <!-- ADR-0016: Sonar's rules run in every build, tests included; TreatWarningsAsErrors makes them fail it. -->
    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    </ItemGroup>
</Project>
