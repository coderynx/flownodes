<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <WebClientDirectory>$(MSBuildProjectDirectory)/../Web.Client/</WebClientDirectory>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Postgres" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <WebClientInput Include="$(WebClientDirectory)**" Exclude="$(WebClientDirectory)node_modules/**" />
  </ItemGroup>

  <!-- HACK: MSBuild evaluates wwwroot before the client build rewrites it, so Content holds nothing on a clean tree and
       a deleted bundle after a rename. It is listed again here, or the build serves nothing or fails. -->
  <Target Name="BuildWebClient" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(SkipWebClient)' != 'true'"
          Inputs="@(WebClientInput)" Outputs="wwwroot/index.html">
    <!-- HACK: npm ci deletes node_modules, which a running Vite dev server serves its dependencies from, and the AppHost
         starts Vite before an IDE builds the host. -->
    <Exec Command="npm ci" WorkingDirectory="$(WebClientDirectory)" Condition="!Exists('$(WebClientDirectory)node_modules')" />
    <Exec Command="npm install" WorkingDirectory="$(WebClientDirectory)" Condition="Exists('$(WebClientDirectory)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebClientDirectory)" />
    <ItemGroup>
      <Content Remove="wwwroot/**" />
      <Content Include="wwwroot/**" />
    </ItemGroup>
  </Target>

</Project>
