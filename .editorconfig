root = true

# ADR-0022: layout standard, applied by scripts/format.sh through the "Flownodes" cleanup profile in
# Flownodes.slnx.DotSettings. The resharper_* keys drive that profile; the build keeps failing on missing braces,
# block-scoped namespaces and needless qualification.
[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0003.severity = warning
resharper_csharp_blank_lines_around_auto_property = 0
resharper_csharp_blank_lines_around_single_line_auto_property = 0
resharper_csharp_blank_lines_around_single_line_property = 0
resharper_csharp_keep_blank_lines_in_declarations = 0
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_remove_blank_lines_near_braces_in_declarations = true
resharper_csharp_keep_user_linebreaks = false
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_wrap_after_declaration_lpar = true
resharper_csharp_wrap_primary_constructor_parameters_style = chop_if_long
resharper_csharp_wrap_after_primary_constructor_declaration_lpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_after_invocation_lpar = true
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_before_first_method_call = false
resharper_csharp_wrap_after_property_in_chained_method_calls = false
resharper_csharp_wrap_object_and_collection_initializer_style = chop_if_long
resharper_csharp_max_line_length = 120
resharper_csharp_braces_for_ifelse = required
resharper_csharp_braces_for_for = required
resharper_csharp_braces_for_foreach = required
resharper_csharp_braces_for_while = required
resharper_csharp_braces_for_dowhile = required
resharper_csharp_braces_for_using = required
resharper_csharp_braces_for_lock = required
resharper_csharp_braces_for_fixed = required
resharper_csharp_namespace_body = file_scoped
resharper_csharp_instance_members_qualify_members = none
resharper_csharp_static_members_qualify_members = none
resharper_csharp_trailing_comma_in_multiline_lists = false
resharper_csharp_trailing_comma_in_singleline_lists = false
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# ADR-0021: StyleCop checks documentation on externally exposed contracts only.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1611.severity = warning
dotnet_diagnostic.SA1615.severity = warning
dotnet_diagnostic.SA1618.severity = warning

# ADR-0016: Sonar way, less the rules that fight a deliberate decision. Suppressions live here only.
# S3871: exceptions that never leave their module stay internal (ADR-0017).
dotnet_diagnostic.S3871.severity = none

# ADR-0024: nothing is dead. Sonar covers private members, parameters and locals; these close its gaps.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# S1144: EF materialises entities through their private setters, which Sonar sees as unused (ADR-0019).
[**/*.Domain/**.cs]
dotnet_diagnostic.S1144.severity = none

# S2094: a message with nothing to carry is still a type of its own, because Wolverine routes messages by type (ADR-0013).
[**/Core.Contracts/**.cs]
dotnet_diagnostic.S2094.severity = none

# Generated by dotnet ef; left as the tooling writes it (ADR-0017).
[**/Database/Migrations/**.cs]
generated_code = true

# Generated by Wolverine (`dotnet run --project apps/Flownodes -- codegen write`); committed so Silos never compile at runtime (ADR-0013).
[apps/Flownodes/Internal/Generated/**.cs]
generated_code = true
